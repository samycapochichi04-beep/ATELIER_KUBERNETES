# Exercice 4 — La page HTML de votre site, stockée dans le cluster.
# Une ConfigMap contient de la configuration (ou de petits fichiers) séparée de l'image.
apiVersion: v1
kind: ConfigMap
metadata:
  name: site-html
data:
  # Chaque clé devient un fichier quand la ConfigMap est montée comme volume.
  index.html: |
    <!doctype html>
    <html lang="fr">
      <head><meta charset="utf-8"><title>Mon site sur Kubernetes</title></head>
      <body>
        <h1>Bienvenue sur mon site</h1>
        <!-- TODO : personnalisez la page (votre nom, votre groupe...) -->
        <p>Servi par Kubernetes.</p>
      </body>
    </html>
